<Window
    x:Class="cs2importer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="20" Width="400">
            <!-- Source 1 & CS2 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Source 1 -->
                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="2" Padding="10">
                    <StackPanel Spacing="10">
                        <TextBlock Text="SOURCE 1 GAME" HorizontalAlignment="Center" FontWeight="Bold" />
                        <ComboBox x:Name="S1GameCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <x:String>csgo</x:String>
                            <x:String>css</x:String>
                        </ComboBox>
                        <Border BorderBrush="Black" BorderThickness="2" Padding="10">
                            <StackPanel Spacing="5" HorizontalAlignment="Center">
                                <TextBlock Text="show" HorizontalAlignment="Center" />
                                <TextBlock Text="gamefolder" HorizontalAlignment="Center" />
                                <TextBlock Text="here" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="S1FolderBtn" Content="Select Folder" HorizontalAlignment="Stretch" Click="OnS1FolderClick" />
                        <Button x:Name="S1ValidateBtn" Content="validate" HorizontalAlignment="Stretch" Click="OnS1ValidateClick" />
                    </StackPanel>
                </Border>

                <!-- Arrow -->
                <TextBlock Grid.Column="1" Text="&#x27A1;" FontSize="40" VerticalAlignment="Center" Margin="10,0" />

                <!-- CS2 -->
                <Border Grid.Column="2" BorderBrush="Black" BorderThickness="2" Padding="10">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Counter Strike 2" HorizontalAlignment="Center" FontWeight="Bold" />
                        <Border BorderBrush="Black" BorderThickness="2" Padding="10" MinHeight="80">
                            <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Press to select" HorizontalAlignment="Center" />
                                <TextBlock Text="game folder" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="CS2FolderBtn" Content="Select Folder" HorizontalAlignment="Stretch" Click="OnCS2FolderClick" />
                        <Button x:Name="CS2ValidateBtn" Content="validate" HorizontalAlignment="Stretch" Click="OnCS2ValidateClick" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- VMF/BSP & Addon Name -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="2" Padding="10">
                    <StackPanel Spacing="5">
                        <TextBlock Text="vmf/bsp name" HorizontalAlignment="Center" />
                        <Button x:Name="VmfBtn" Content="Select VMF" HorizontalAlignment="Stretch" Click="OnVmfClick" />
                        <Button x:Name="BspBtn" Content="Select BSP" HorizontalAlignment="Stretch" Click="OnBspClick" />
                    </StackPanel>
                </Border>

                <!-- Arrow -->
                <TextBlock Grid.Column="1" Text="&#x27A1;" FontSize="40" VerticalAlignment="Center" Margin="10,0" />

                <Border Grid.Column="2" BorderBrush="Black" BorderThickness="2" Padding="10">
                    <StackPanel Spacing="5">
                        <TextBlock Text="s2 addon name" HorizontalAlignment="Center" />
                        <TextBox x:Name="AddonNameBox" PlaceholderText="Enter addon name" />
                    </StackPanel>
                </Border>
            </Grid>

            <Button x:Name="StartBtn" Content="START" HorizontalAlignment="Stretch" Click="OnStartClick" BorderBrush="Black" BorderThickness="2" />

            <Border BorderBrush="Black" BorderThickness="2" Padding="10">
                <StackPanel Spacing="10">
                    <TextBlock Text="OPTIONS" HorizontalAlignment="Center" />
                    <CheckBox x:Name="UseBspCheck" Content="Clean unnecessary faces" IsChecked="True" Checked="OnUseBspChecked" Unchecked="OnUseBspChecked" />
                    <CheckBox x:Name="KeepInstancesCheck" Content="keep instances" />
                    <CheckBox x:Name="SkipDepsCheck" Content="skip references import" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Right Side: Log -->
        <Grid Grid.Column="1" Margin="20,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" x:Name="HideLogBtn" Content="HIDE" Click="OnHideLogClick" BorderBrush="Black" BorderThickness="2" Margin="0,0,0,5" HorizontalAlignment="Left" />
            <ScrollViewer Grid.Row="1" x:Name="LogScroll" Background="Black" BorderBrush="Black" BorderThickness="2">
                <TextBlock x:Name="LogText" Foreground="White" FontFamily="Consolas" Padding="10" TextWrapping="Wrap" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
